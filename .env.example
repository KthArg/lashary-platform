NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# CMS externo (docs/contracts/cms-api.md). Solo servidor: sin prefijo NEXT_PUBLIC_.
# Vacío = la landing sirve el contenido de respaldo en código.
CMS_URL=
# Secreto HMAC del aviso al publicar; el mismo valor que WEBHOOK_SECRET en lashary-cms (≥ 32 caracteres).
# Vacío = POST /api/cms/webhook responde 503 y el contenido se renueva solo por TTL (10 min).
CMS_WEBHOOK_SECRET=

# Canal de notificaciones (ADR-0006, US-NOT-03). Vacío = ese canal se declara no configurado y
# no envía; nunca falla por sorpresa en producción.
# WhatsApp vía la Graph API de Meta directo (sin Twilio ni otro intermediario, developers.facebook.com).
# META_WHATSAPP_ACCESS_TOKEN: token del System User (permanente) o el temporal del modo de prueba.
# META_WHATSAPP_PHONE_NUMBER_ID: el "Phone number ID" de la página API Setup de la app en Meta.
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
# Vacío = manda el mensaje como texto libre (solo funciona dentro de una sesión ya abierta por la
# clienta — sirve para probar con el modo de prueba de Meta). Con un número de WhatsApp Business
# real, Meta exige una plantilla aprobada para que el negocio le escriba primero a la clienta: el
# nombre de esa plantilla va aquí. Debe declarar exactamente 2 variables en el cuerpo, en este
# orden: 1) técnica reservada, 2) fecha y hora de la cita.
META_WHATSAPP_TEMPLATE_NAME=
# Código de idioma de la plantilla tal como se aprobó en Meta (ej. es, es_CR). Por defecto: es.
META_WHATSAPP_TEMPLATE_LANGUAGE=
RESEND_API_KEY=
RESEND_FROM_ADDRESS=

# Cuenta de staff que usa el cron de recordatorios para autenticarse (sin cookies ni
# service-role key, SEC-003/004): debe existir en Supabase con role admin/superadmin en
# auth_user_roles, igual que la cuenta de la administradora (US-AUTH-01).
NOTIFICATIONS_CRON_EMAIL=
NOTIFICATIONS_CRON_PASSWORD=

# Secreto que Vercel Cron manda como Authorization: Bearer <valor> en cada corrida.
CRON_SECRET=
