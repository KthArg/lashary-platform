NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# CMS externo (docs/contracts/cms-api.md). Solo servidor: sin prefijo NEXT_PUBLIC_.
# Vacío = la landing sirve el contenido de respaldo en código.
CMS_URL=
# Secreto HMAC del aviso al publicar; el mismo valor que WEBHOOK_SECRET en lashary-cms (≥ 32 caracteres).
# Vacío = POST /api/cms/webhook responde 503 y el contenido se renueva solo por TTL (10 min).
CMS_WEBHOOK_SECRET=

# Canal de notificaciones (ADR-0006, US-NOT-03). Vacío = ese canal se declara no configurado y
# no envía; nunca falla por sorpresa en producción.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Vacío = manda el mensaje como texto libre (sirve en el sandbox de Twilio). Con un número de
# WhatsApp Business real, Meta exige una plantilla aprobada para que el negocio le escriba
# primero a la clienta: el SID de esa plantilla va aquí. La plantilla que se pida en Meta debe
# tener exactamente 2 variables, en este orden: 1) técnica reservada, 2) fecha y hora de la cita.
TWILIO_CONTENT_SID=
RESEND_API_KEY=
RESEND_FROM_ADDRESS=

# Cuenta de staff que usa el cron de recordatorios para autenticarse (sin cookies ni
# service-role key, SEC-003/004): debe existir en Supabase con role admin/superadmin en
# auth_user_roles, igual que la cuenta de la administradora (US-AUTH-01).
NOTIFICATIONS_CRON_EMAIL=
NOTIFICATIONS_CRON_PASSWORD=

# Secreto que Vercel Cron manda como Authorization: Bearer <valor> en cada corrida.
CRON_SECRET=
